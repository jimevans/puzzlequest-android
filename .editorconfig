root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
# Compose's convention: composable functions are named like types.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{json,yml,yaml}]
indent_size = 2

[*.sh]
indent_size = 2
