<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing the app keeps is backed up or moved to a new phone: today that's
     the sessions, which are this phone's, and the server chosen in Options. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
