    <string name="activated">Activated</string>
    <string name="finished">Finished</string>
    <string name="time">Time</string>
    <string name="hint_penalties">Hint penalties</string>
    <string name="total">Total</string>

    <!-- What TalkBack says as the quest changes on screen -->
    <string name="announce_paused">Paused by the puzzle master. The clock is stopped.</string>
    <string name="announce_resumed">The quest has resumed.</string>
    <!-- Such as "Stop 2 reached: The Lighthouse." The number says which stop
         it is, not how many, so it isn't a plural. -->
    <string name="announce_stop_reached" tools:ignore="PluralsCandidate">Stop %1$d reached: %2$s.</string>
    <string name="announce_stop_solved">%1$s is solved.</string>
    <string name="announce_finished">End of the line.</string>
    <!-- Another team finishing a race, such as "Gulls finished 2nd." -->
    <string name="announce_rival_finished">%1$s finished %2$s.</string>
    <!-- Such as "Final standings: Gulls won." or "Final standings: Gulls and Crabs won." -->
    <string name="announce_final_standings">Final standings: %1$s won.</string>

    <!-- Verifying an email address -->
    <string name="verify_email">Please verify your email address: follow the link in the email we sent you.</string>
    <string name="send_email_again">Send the email again</string>
    <string name="email_sent">Sent. Check your inbox.</string>
    <string name="email_too_many">The email has been sent several times lately. Wait a few minutes, then try again.</string>

